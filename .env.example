# Base URL of the Paperless-ngx web server. A sub-path is supported.
PAPERLESS_URL=http://localhost:8000

# Create the token in Paperless-ngx under Profile > API token.
PAPERLESS_TOKEN=replace-me

# Optional settings
PAPERLESS_API_VERSION=10
PAPERLESS_REQUEST_TIMEOUT_MS=15000
PAPERLESS_READ_ONLY=true
